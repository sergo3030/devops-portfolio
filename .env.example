# Copy to .env (gitignored) for local runs. Never commit real values.
# No AWS credentials belong here: CI uses GitHub OIDC, and local AWS
# credentials are used only for the one-time bootstrap (task 6).

AWS_REGION=us-east-1
# Email for Budget alerts, set when applying bootstrap (task 6), never committed:
# TF_VAR_budget_alert_email=

# Used when applying infra/github, to publish the account ID as a GitHub Actions
# variable without writing it in a file. Read it with: aws sts get-caller-identity
# TF_VAR_aws_account_id=
