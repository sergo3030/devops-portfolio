<mxfile host="app.diagrams.net">
  <diagram id="release" name="How a change reaches production">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="700" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="Who" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="110" height="24" as="geometry"/></mxCell>
        <mxCell id="h2" value="Step" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="150" y="12" width="360" height="24" as="geometry"/></mxCell>
        <mxCell id="h3" value="Workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="540" y="12" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="run" value="one release run" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#999999;dashed=1;dashPattern=6 4;verticalAlign=top;align=right;spacingRight=12;spacingTop=4;fontStyle=2;fontSize=11;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="140" y="283" width="610" height="262" as="geometry"/></mxCell>
        <mxCell id="b1" value="Automatic" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="63" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n1" value='&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;lint, tests, scans, plan&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="50" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w1" value="ci · codeql · plan" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="63" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="b2" value="You" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="143" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value='&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;rebase-and-merge, all checks green, no bypass&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w2" value="no build, no deploy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="143" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="b3" value="You" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="223" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n3" value='&lt;b&gt;Tag a release&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;push vX.Y.Z&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="210" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w3" value="release-tag, then release" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="223" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="b4" value="Automatic" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="328" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n4" value='&lt;b&gt;Build image&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;scan, push to ECR by digest&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="315" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w4" value="release (calls image)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="328" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="b5" value="You" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="408" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n5" value='&lt;b&gt;Owner approval&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;prod environment, main only&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="395" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w5" value="deploy (waiting job)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="408" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="b6" value="Automatic" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="488" width="110" height="30" as="geometry"/></mxCell>
        <mxCell id="n6" value='&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;apply the checked plan, verify /health&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="475" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="w6" value="deploy (called by release)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#dddddd;fontFamily=Courier New;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="488" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="n7" value='&lt;b&gt;AWS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#555555"&gt;ECR, Lambda&lt;/font&gt;' style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="585" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="OIDC" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Short-lived OIDC credentials at every AWS step. No stored cloud keys. Merging alone never deploys." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="662" width="720" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
