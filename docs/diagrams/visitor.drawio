<mxfile host="app.diagrams.net">
  <diagram id="visitor" name="What a visitor touches">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1030" pageHeight="320" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="gh" value="GitHub Pages" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3b5a85;" vertex="1" parent="1">
          <mxGeometry x="190" y="30" width="300" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="aws" value="AWS · us-east-1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fffaf3;strokeColor=#d79b00;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#8a5a00;" vertex="1" parent="1">
          <mxGeometry x="720" y="30" width="290" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="visitor" value="Visitor" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="75" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="site" value="&lt;b&gt;Static site&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;React, built once, served by GitHub Pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="215" y="75" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="copy" value="&lt;b&gt;Saved copy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;built into the site, shown first&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#e8f0fb;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="215" y="185" width="250" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="furl" value="&lt;b&gt;Function URL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;read-only, size-limited, CORS for the site only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="75" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;FastAPI container image&lt;br&gt;concurrency capped at 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="185" width="240" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="opens" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="visitor" target="site">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="renders first" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="site" target="copy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="then fetches live data&lt;br&gt;(swapped in within 8 s)" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="site" target="furl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="furl" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="The site works without the API: if it is slow or down, the saved copy stays." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="190" y="285" width="820" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
