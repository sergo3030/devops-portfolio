# Secrets and local config
.env
.env.*
!.env.example
# The production build reads the API address from this file. It is public by design (docs/web.md).
!web/.env.production
*.pem
*.key
terraform.tfvars
*.auto.tfvars
secrets/

# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
tfplan
tfplan[0-9]*
# Saved plans hold sensitive values (alert email, account ID). Never commit them.
override.tf
override.tf.json
# The lock file IS committed: do not ignore .terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

