{
  "name": "portfolio-web",
  "private": true,
  "version": "0.0.0",
  "description": "The static portfolio site. The version here is a placeholder, see docs/api.md.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "json2ts --input ../content/schema/published.schema.json --output src/generated/content.ts --no-bannerComment",
    "dev": "npm run types && vite",
    "build": "npm run types && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "npm run types && vitest run",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:page": "node scripts/check-built-page.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
